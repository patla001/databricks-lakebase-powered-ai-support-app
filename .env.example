# Copy this file to .env for local development (.env is gitignored).
#
# LAKEBASE_URL here is a LOCAL-DEV OVERRIDE: when set, the app uses it directly
# and never contacts Databricks. Leave it unset to read from the Databricks
# secret scope instead - which is the path the deployed app takes, since it has
# no .env of its own.
#
# Do NOT commit a filled-in .env.

# <your-lakebase-host> is the full host from your Lakebase instance's connection
# details - it already includes its own domain
# (e.g. ep-xxxx-xxxx.database.us-west-2.cloud.databricks.com).
# Paste it whole; do NOT append anything to it.
LAKEBASE_URL=postgresql://support_app:<password>@<your-lakebase-host>:5432/databricks_postgres?sslmode=require

# --- Databricks secret scope/key names (used when LAKEBASE_URL is unset) ---
# LAKEBASE_SECRET_SCOPE=support
# LAKEBASE_SECRET_KEY=lakebase-url

# --- Optional local overrides ---
# FLASK_RUN_HOST=0.0.0.0
# FLASK_RUN_PORT=8000
# FLASK_DEBUG=1
# Identity used for created_by / author when running locally without Databricks
# auth. In the deployed app this comes from the X-Forwarded-Email header.
# LOCAL_USER_EMAIL=local@dev
# Table names (defaults shown).
# TICKETS_TABLE_NAME=tickets
# MESSAGES_TABLE_NAME=ticket_messages
